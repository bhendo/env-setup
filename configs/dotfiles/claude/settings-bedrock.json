{
  "env": {
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "AWS_REGION": "us-east-2",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "us.anthropic.claude-opus-4-8[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "us.anthropic.claude-sonnet-5-5[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "us.anthropic.claude-haiku-5-5"
  },
  "model": "us.anthropic.claude-opus-5-5[1m]",
  "fallbackModel": ["us.anthropic.claude-opus-4-8[1m]"],
  "modelPicker": {
    "replaceBuiltInOptions": true,
    "options": [
      { "model": "us.anthropic.claude-opus-5-5[1m]", "label": "Opus 5.5" },
      { "model": "us.anthropic.claude-opus-4-8[1m]", "label": "Opus 4.8" },
      { "model": "us.anthropic.claude-opus-4-6-v1[1m]", "label": "Opus 4.6" },
      { "model": "us.anthropic.claude-sonnet-5-5[1m]", "label": "Sonnet 5.5" },
      { "model": "us.anthropic.claude-haiku-5-5", "label": "Haiku 5.5" },
      { "model": "us.anthropic.claude-fable-5-1[1m]", "label": "Fable 5.1" }
    ]
  }
}
